%YAML 1.2
---
name: Neon
file_extensions:
  - neon
scope: source.neon

contexts:
  main:
    - include: comments
    - include: strings
    - include: numbers
    - include: function_definitions
    - include: keywords
    - include: builtins
    - include: function_calls
    - include: operators
    - include: types
    - match: \b[a-zA-Z_]\w*\b
      scope: variable.other.neon

  comments:
    - match: '//.*$'
      scope: comment.line.double-slash.neon
    - match: '/\*'
      scope: comment.block.neon
      push:
        - meta_scope: comment.block.neon
        - match: '.*\*/'
          pop: true
        - match: '.+'

  strings:
    - match: '"'
      scope: punctuation.definition.string.begin.neon
      push: double_quoted_string
    - match: "'"
      scope: punctuation.definition.string.begin.neon
      push: single_quoted_string

  double_quoted_string:
    - meta_scope: string.quoted.double.neon
    - match: '\\n'
      scope: constant.character.escape.neon
    - match: '"'
      scope: punctuation.definition.string.end.neon
      pop: true
    - match: '\\.'
      scope: constant.character.escape.neon

  single_quoted_string:
    - meta_scope: string.quoted.single.neon
    - match: '\\n'
      scope: constant.character.escape.neon
    - match: "'"
      scope: punctuation.definition.string.end.neon
      pop: true
    - match: '\\.'
      scope: constant.character.escape.neon

  numbers:
    - match: \b-?\d+(\.\d+)?\b
      scope: constant.numeric.neon
    # also catch hex if you ever want it highlighted
    - match: \b-?0[xX][0-9a-fA-F]+\b
      scope: constant.numeric.hex.neon

  keywords:
    # Declarations & definitions
    - match: \b(func|import|var|const|define|enum|abstract)\b
      scope: storage.modifier.neon

    # Control flow
    - match: \b(for|while|break|continue)\b
      scope: keyword.control.flow.neon

    # Conditional logic
    - match: \b(if|elseif|else|is)\b
      scope: keyword.control.conditional.neon

    # Block delimiters & return
    - match: \b(return)\b
      scope: keyword.control.block.neon

    # Case selector
    - match: \b(case)\b
      scope: keyword.control.case.neon

    # Platform filter (the important new bit)
    - match: \b(platform)\b
      scope: keyword.control.platform.neon
      push: platform_names

    # Type declaration
    - match: \b(type)\b
      scope: storage.type.neon

  platform_names:
    # the first (or subsequent) platform identifier
    - match: \b\w+\b
      scope: entity.name.platform.neon
    # the "or" connector
    - match: \bor\b
      scope: keyword.operator.logical.neon
    # once we hit anything else (usually '{') we pop back
    - match: '(?=\{)'
      pop: true
    - match: '.|\n'
      pop: true

  types:
    - match: \b(int|string|uint|char|boolean|void|float|ulong|uchar)\b
      scope: storage.type.neon

  builtins:
    # {name}<<type>>([something])
    # e.g: Cast<int>(a)
    - match: \b(Cast|ptr|volatile|struct|Array|Raw)\b
      scope: support.function.builtin.neon

  function_calls:
    - match: \b[a-zA-Z_]\w*(?=\()
      scope: entity.name.function.neon

  function_definitions:
    - match: \bfunc\b\s+(\w+)
      captures:
        1: entity.name.function.definition.neon
      scope: storage.modifier.neon

  operators:
    - match: \.\.\.
      scope: keyword.operator.variadic.neon
    - match: ==|!=|<=|>=|\+=|-=|\*=|/=|&&|\|\||[=+\-*/<>%]
      scope: keyword.operator.neon
    - match: '[\(\)\[\]\{\}\.,:;]'
      scope: punctuation.separator.neon