/*
no clue what gcc/clang hides in it
nor if there's some kernel thing i need to read
*/
type FILE
#include <stddef.h>
abstract size_t

fn printf(fmt string, ...) int @def
fn fopen(path string, mode string) ptr<FILE> @def
fn fclose(fd ptr<FILE>) int @def
fn rewind(fd ptr<FILE>) void @def
fn fseek(fd ptr<FILE>, offset ulong, position int) int @def
fn ftell(fd ptr<FILE>) uint @def
fn feof(fd ptr<FILE>) int @def
fn fprintf(fd ptr<FILE>, fmt string, ...) int @def
fn ferror(fd ptr<FILE>) int @def
fn snprintf(buf ptr<char>, size ulong, fmt string, ...) int @def

#define panicf(fmt, ...) do{printf("%s:%i: " fmt "\n", __FILE__, __LINE__, __VA_ARGS__);exit(1);}while(0)
#define panic(fmt) do{printf("%s:%i: " fmt "\n", __FILE__, __LINE__);exit(1);}while(0)

fn perror(msg string) void @def
fn exit(code int) void @def
fn abs(i int) int @def
fn malloc(size ulong) ptr<void> @def
fn realloc(data ptr<void>, size size_t) ptr<void> @def
fn free(mem ptr<void>) void @def

enum FileSeekPositions = {
    FILE_START      /* Seek from beginning of file.  */
    FILE_CURRENT    /* Seek from current position.   */
    FILE_END        /* Seek from end of file.        */
}

fn fread(
    dataBuffer ptr<void>, size ulong,
    nbytes ulong, fileStream ptr<FILE>) ulong @def

var nil ptr<void> = ptr<void>(0)
// null is defined like this in __stddef_null.h 
// #define NULL ((void*)0)

fn clamp(target float, min float, max float) float
{
	if target >= max {
		return max
	}
	elseif target <= min {
		return min
	}
	else{
		return target
	}
}

fn assert(cond boolean, msg string) void
{
	if ! cond {
		printf("Assertion failed: %s\n", msg)
		exit(1)
	}
}

fn Max(a int, b int) int
{
	if a > b {return a}
	return b
}

fn Min(a int, b int) int
{
	if a < b {return a}
	return b
}

fn Sign(x float) float
{
	if x < 0 {return -1}
	return 1
}
