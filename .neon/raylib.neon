fn Vector2Add(vec1 Vector2, vec2 Vector2) Vector2 @def
fn Vector2Scale(vec Vector2, scale float) Vector2 @def
fn Vector2Clamp(vec1 Vector2, min Vector2, max Vector2) Vector2 @def
fn DrawFPS(x int, y int) void @def
