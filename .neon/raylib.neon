//     math functions      //
func Vector2Add(vec1 Vector2, vec2 Vector2) @declaration ->Vector2
func Vector2Scale(vec Vector2, scale float) @declaration ->Vector2
func Vector2Clamp(vec1 Vector2, min Vector2, max Vector2) @declaration ->Vector2
func DrawFPS(x int, y int) @declaration ->void
