#!/usr/bin/env python
# neon2c
import argparse
import subprocess
import tempfile
import os
import shlex  # <-- new import

from generate import TYPES, Parser, generate_c, generate_h, sys, tokenize


class SplitArgs(argparse.Action):
    """Custom action that splits the argument string into a list of arguments."""

    def __call__(self, parser, namespace, values, option_string=None):
        # values is already a string because nargs=None
        split_values = shlex.split(values)
        dest = getattr(namespace, self.dest, [])
        dest.extend(split_values)
        setattr(namespace, self.dest, dest)


def main() -> None:
    parser = argparse.ArgumentParser(prog="neon", description="Neon language toolchain")
    sub = parser.add_subparsers(dest="command", required=True)

    # ---------------- build ----------------
    build = sub.add_parser("build", help="Compile Neon source")
    build.add_argument("input", help="Neon source file")
    build.add_argument("-o", "--output", help="Output executable")
    build.add_argument("--cc", default=os.environ.get("CC", "cc"), help="C compiler")

    # New: --cflags / --ldflags that split their value
    build.add_argument(
        "--cflags",
        "--cflag",  # accept both
        action=SplitArgs,
        default=[],
        help="C compiler flags (space separated, can be used multiple times)",
    )
    build.add_argument(
        "--ldflags",
        "--ldflag",
        action=SplitArgs,
        default=[],
        help="Linker flags (space separated, can be used multiple times)",
    )

    build.add_argument(
        "-l", "--lib", action="append", default=[], help="Link with library"
    )
    build.add_argument(
        "--with",
        dest="link_with",
        action="append",
        default=[],
        help="Additional object files",
    )
    build.add_argument("-v", "--verbose", action="count", default=0)

    # ---------------- run ----------------
    run = sub.add_parser("run", help="Compile and run, accepts same flags as 'build'")
    run.add_argument("input", help="Neon source file")
    run.add_argument("-o", "--output", help="Output executable")
    run.add_argument("--cc", default=os.environ.get("CC", "cc"), help="C compiler")
    run.add_argument("-v", "--verbose", action="count", default=0)

    # ---------------- emit ----------------
    emit = sub.add_parser("emit", help="Emit generated C code")
    emit.add_argument("type", choices=["c", "h"], help="emit C or header")
    emit.add_argument("input", help="Neon source file")
    emit.add_argument("-o", "--output", help="Output C file")

    # ---------------- dump ----------------
    dump = sub.add_parser("dump", help="Dump internal representation")
    dump.add_argument("what", choices=["tokens", "ast", "types"])
    dump.add_argument("input", help="Neon source file")

    args = parser.parse_args()

    # ---------------- read file ----------------
    try:
        with open(args.input, "r") as f:
            dsl_code = f.read()
    except Exception as e:
        raise os.error(f"Error reading {args.input}: {e}")

    tokens = tokenize(dsl_code, args.input)
    neon_parser = Parser(tokens, dsl_code, os.path.dirname(args.input), args.input)
    ast = neon_parser.parse()

    # ---------------- dump mode ----------------
    if args.command == "dump":
        if args.what == "tokens":
            for t in tokens:
                print(t)
        elif args.what == "ast":
            print(ast)
        elif args.what == "types":
            for item in TYPES:
                print(item)
        return

    # ---------------- emit mode ----------------
    if args.command == "emit":
        if args.type == "c":
            c_code = generate_c(ast)
            output = args.output
            if not output:
                print(c_code)
                return
            with open(output, "w") as f:
                f.write("/* code generated by Neon */\n" + c_code)
            print(f"C code written to {output}")
            return
        elif args.type == "h":
            h_code = generate_h(ast)
            output = args.output
            if not output:
                print(h_code)
                return
            with open(output, "w") as f:
                f.write("/* code generated by Neon */\n" + h_code)
            print(f"C code written to {output}")
            return
    # ---------------- build / run ----------------
    if args.command in ("build", "run"):
        c_code = generate_c(ast)

        output_exe = os.path.abspath(
            args.output or os.path.splitext(os.path.basename(args.input))[0]
        )

        cc = args.cc
        verbose = args.verbose

        cflags = args.cflags  # already a list of split flags
        ldflags = args.ldflags
        link_with = args.link_with
        libs = ["-l" + lib for lib in args.lib]

        with tempfile.NamedTemporaryFile(mode="w+t") as fd:
            fd.write(c_code)
            fd.flush()

            cmd = [
                cc,
                "-x",
                "c",
                fd.name,
                *link_with,
                "-o",
                output_exe,
                *cflags,
                *[f"-Wl,{f}" for f in ldflags],
                *libs,
            ]

            if verbose:
                print("[neon] cc command:")
                print(" ", " ".join(cmd))

            result = subprocess.run(
                cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            )

            if result.returncode != 0:
                sys.stderr.write(result.stderr.decode())
                sys.exit("cc compilation failed")

            if verbose:
                print(f"[neon] compilation successful: {output_exe}")

        if args.command == "run":
            if verbose:
                print(f"[neon] running {output_exe}")
            subprocess.run([output_exe])

        return


if __name__ == "__main__":
    main()
